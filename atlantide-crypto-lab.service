[Unit]
Description=ATLANTIDE CRYPTO LAB — SOL/USDT Paper Trading Simulator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
WorkingDirectory=/home/openclaw/workspace/atlantide-crypto-lab
ExecStart=/home/openclaw/workspace/atlantide-crypto-lab/venv/bin/python /home/openclaw/workspace/atlantide-crypto-lab/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
