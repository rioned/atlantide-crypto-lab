[Unit]
Description=CRYPTO LAB 2 — Multi-Symbol Pattern Scalp Simulator (15m, 1:2 RR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
WorkingDirectory=/home/openclaw/workspace/crypto-lab2
ExecStart=/home/openclaw/workspace/crypto-lab2/venv/bin/python3 -m gunicorn -k gthread -w 1 --threads 4 --bind 0.0.0.0:9090 --timeout 120 --keep-alive 30 wsgi:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
